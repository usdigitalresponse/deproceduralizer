# Copy to .env (repo root; frontend/apps/web/.env symlinks here) and fill in.

# ---- Database ---------------------------------------------------------------
# Production/preview: a Neon connection string.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Local Docker stack instead (docker compose -f docker-compose.e2e.yml up -d --wait):
# the app reaches Postgres through the bundled Neon proxy, so uncomment both lines.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/deproceduralizer_e2e
# NEON_LOCAL_PROXY_URL=http://localhost:4444
# If 5432 is taken, start the stack with E2E_PG_PORT=55432 and use that port above.
# E2E_PG_PORT=55432
# The seed script connects directly; it falls back to DATABASE_URL when unset.
# E2E_DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/deproceduralizer_e2e

# ---- Frontend ---------------------------------------------------------------
SITE_PASSWORD=change-me
# Lets e2e/auth.spec.ts run the two tests that log in with the real password.
# E2E_SITE_PASSWORD=change-me
# Auth is bypassed in `next dev`; set this to bypass it in a production build too.
# NEXT_PUBLIC_VERCEL_ENV=preview

# ---- Backend pipelines ------------------------------------------------------
ANTHROPIC_API_KEY=
# NY statutes scraper (free key from https://legislation.nysenate.gov/)
NY_OPEN_LEG_API_KEY=
