    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^1.6.1",
    "@visx/group": "^3.12.0",
    "@visx/hierarchy": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-shape": "^3.2.0",
    "js-yaml": "^4.1.1",
