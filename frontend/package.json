{
  "name": "deproceduralizer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:e2e:up": "docker compose -f ../docker-compose.e2e.yml up -d --wait",
    "db:e2e:reset": "bash ../scripts/e2e-db-reset.sh",
    "db:e2e:down": "docker compose -f ../docker-compose.e2e.yml down -v"
  },
  "devDependencies": {
    "next": "16.4.1"
  },
  "packageManager": "pnpm@9.15.1",
  "dependencies": {
    "sonner": "^2.0.7"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "^6.14.0",
      "brace-expansion@<1.1.13": "^1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
      "esbuild@<0.25.0": "^0.25.0",
      "flatted@<3.4.2": "^3.4.2",
      "lodash@<4.17.23": "^4.17.23",
      "lodash-es@<4.18.0": "^4.18.0",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.10": "^8.5.10",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "vite@>=7.0.0 <7.3.2": "^7.3.2"
    }
  }
}
